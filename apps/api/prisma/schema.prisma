datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ThreatIndicator {
  id                String   @id @default(uuid()) @db.Uuid
  indicatorValue    String   @map("indicator_value")
  indicatorType     String   @map("indicator_type")
  severity          String   @default("LOW")
  confidenceScore   Int      @default(0) @map("confidence_score")
  enrichmentSummary String?  @map("enrichment_summary") @db.Text
  mitreTechniques   String[] @map("mitre_techniques")
  rawPayload        Json     @map("raw_payload") @db.JsonB
  firstSeen         DateTime @default(now()) @map("first_seen")
  lastSeen          DateTime @default(now()) @map("last_seen")
  createdAt         DateTime @default(now()) @map("created_at")

  // ⚡ Bolt: [performance improvement]
  // Add database indexes natively via Prisma schema for frequently filtered and sorted fields
  // Impact: Eliminates sequential table scans when querying large indicator datasets, matching the raw SQL intentions.
  @@index([mitreTechniques], type: Gin)
  @@index([indicatorType, confidenceScore])
  @@index([severity])
  @@index([indicatorValue])

  @@map("threat_indicators")
}
